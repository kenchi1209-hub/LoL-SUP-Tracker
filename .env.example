# .env.example をコピーして .env を作成してください
#   cp .env.example .env
#
# RIOT_API_KEY: https://developer.riotgames.com/ で取得
#   ※ 開発用キー(RGAPI-...)は24時間で失効します。
#     毎日の自動更新を止めずに動かすには、失効しないキーの発行申請が必要です。
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Riot ID（ゲーム内の名前 と #以降のタグ）
RIOT_GAME_NAME=YourName
RIOT_TAG_LINE=JP1

# Match ID取得時の1ページあたりの件数（最大100）
MATCH_COUNT=100

# 集計対象期間
START_DATE=2026-01-01
END_DATE=2026-12-31
